# Merge these entries into server/.env. Keep real credentials out of Git.
# 初始顺序：GPT → Gemini → Grok → OpenCode Go → DeepSeek 官方 default。
# 前四个通道可在后台拖拽排序并保存；官方 default 始终最后。
# 通道 ENABLED 默认 true；设为 false 时跳过该通道，保留地址、模型和密钥。
RAG_ENABLED=false

# 本地评测记录目录；留空时关闭。请求需显式携带 X-RAG-Evaluation: 1。
RAG_EVALUATION_TRACE_DIR=

# 传给模型的近期完整问答对；页面仍保留全部记录。
# 轮数范围 1–20，历史字符预算范围 1000–20000，按 Unicode 字符计数。
RAG_HISTORY_MAX_ROUNDS=5
RAG_HISTORY_MAX_CHARACTERS=20000

# GPT，OpenAI 兼容协议；Docker 后端访问宿主机时改为 host.docker.internal。
RAG_CHAT_GPT_ENABLED=true
RAG_CHAT_GPT_BASE_URL=http://127.0.0.1:8317/v1
RAG_CHAT_GPT_MODEL=gpt-6-sol
RAG_CHAT_GPT_PROTOCOL=openai
RAG_CHAT_GPT_API_KEY=
RAG_CHAT_GPT_HEADERS_JSON={}
RAG_CHAT_GPT_EXTRA_BODY_JSON={"reasoning_effort":"medium"}
RAG_CHAT_GPT_TIMEOUT=30s

# Grok，OpenAI 兼容协议。
RAG_CHAT_GROK_ENABLED=true
RAG_CHAT_GROK_BASE_URL=https://ai.hybgzs.com/v1
RAG_CHAT_GROK_MODEL=grok-4.7
RAG_CHAT_GROK_PROTOCOL=openai
RAG_CHAT_GROK_API_KEY=
RAG_CHAT_GROK_HEADERS_JSON={}
RAG_CHAT_GROK_EXTRA_BODY_JSON={}
RAG_CHAT_GROK_TIMEOUT=30s

# Gemini，同一模型已验证 OpenAI 兼容协议。
RAG_CHAT_GEMINI_ENABLED=true
RAG_CHAT_GEMINI_BASE_URL=https://ai.hybgzs.com/v1
RAG_CHAT_GEMINI_MODEL=gemini-3.1-flash-lite-preview
RAG_CHAT_GEMINI_PROTOCOL=openai
RAG_CHAT_GEMINI_API_KEY=
RAG_CHAT_GEMINI_HEADERS_JSON={}
RAG_CHAT_GEMINI_EXTRA_BODY_JSON={}
RAG_CHAT_GEMINI_TIMEOUT=30s

# OpenCode Go，保留原配置键。
RAG_CHAT_PRIMARY_ENABLED=true
RAG_CHAT_PRIMARY_BASE_URL=https://opencode.ai/zen/go/v1
RAG_CHAT_PRIMARY_MODEL=deepseek-v4.1-flash
RAG_CHAT_PRIMARY_API_KEY=
RAG_CHAT_PRIMARY_HEADERS_JSON={}
RAG_CHAT_PRIMARY_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
RAG_CHAT_PRIMARY_SESSION_HEADER=x-opencode-session
RAG_CHAT_PRIMARY_TIMEOUT=30s

# default：DeepSeek 官方固定兜底，不参与优先级调整。
RAG_CHAT_FALLBACK_BASE_URL=https://api.deepseek.com
RAG_CHAT_FALLBACK_MODEL=deepseek-flash
RAG_CHAT_FALLBACK_API_KEY=
RAG_CHAT_FALLBACK_HEADERS_JSON={}
RAG_CHAT_FALLBACK_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
RAG_CHAT_FALLBACK_TIMEOUT=30s

# 向量模型
RAG_EMBEDDING_BASE_URL=https://router.tumuer.me/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_API_KEY=
# Empty: omit dimensions and use the model's native output (BGE-M3: 1024).
RAG_EMBEDDING_DIMENSIONS=

# 重排序模型：同一路由可复用向量密钥，也可填写独立密钥。
RAG_RERANK_BASE_URL=https://router.tumuer.me/v1
RAG_RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3
RAG_RERANK_API_KEY=${RAG_EMBEDDING_API_KEY}
RAG_RERANK_TIMEOUT=10s

# 仅供 Test/rag-provider-probe.mjs 核验 Qwen 8B 候选，不影响在用索引。
HYBGZS_QWEN_API_KEY=
