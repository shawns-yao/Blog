# -------------------- 发布与构建 --------------------
APP_VERSION=local
BUILD_COMMIT=unknown
IMAGE_REPO_PREFIX=
DOCKER_MIRROR=
BUILD_HTTP_PROXY=
NGINX_PORT=127.0.0.1:8088

# -------------------- PostgreSQL --------------------
POSTGRES_DB=shawn-blog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# -------------------- Redis --------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_PREFIX=shawn-blog:
REDIS_DB=0

# -------------------- Go 服务与登录令牌 --------------------
APP_NAME=shawns-blog-server
APP_ENV=development
APP_PORT=8080
DB_DRIVER=postgres
DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}?sslmode=disable
AUTH_SECRET=replace-with-a-strong-secret
AUTH_ISSUER=shawn-blog-api
# 用户账号、密码哈希和管理员标识保存在数据库，不在环境文件中配置。
HTMLSNAPSHOT_BASE_URL=http://127.0.0.1:3000
APP_UPDATE_CHECK_ENABLED=false
APP_UPDATE_CHECK_REPO=shawns-yao/Blog
APP_UPDATE_CHANNEL=stable

# -------------------- 前台与备案 --------------------
INTERNAL_API_BASE_URL=http://127.0.0.1:8080/api/v2
SITE_ICP_NUMBER=冀ICP备2026004228号-2
SITE_ICP_URL=https://beian.miit.gov.cn/

# -------------------- 管理后台 --------------------
VITE_APP_BASE=/admin/
VITE_APP_NAME=shawns-blog
VITE_APP_TITLE=管理后台
VITE_WATERMARK_CONTENT=
VITE_API_BASE_URL=/api/v2
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_RENDERER_BASE_URL=http://127.0.0.1:3000

# -------------------- 音乐与 Navidrome --------------------
MUSIC_ENABLED=false
MUSIC_NAVIDROME_URL=http://127.0.0.1:4533
MUSIC_NAVIDROME_USER=
MUSIC_NAVIDROME_PASSWORD=
# 留空时所有已登录用户可播放受限歌曲；填写编号时仅允许名单用户及管理员。
MUSIC_ALLOWED_USER_IDS=
MUSIC_MAX_UPLOAD_BYTES=104857600
MUSIC_MAX_BIT_RATE=192
MUSIC_TRANSCODING_CACHE_SIZE=1GB
MUSIC_FFMPEG_BINARY=ffmpeg

# -------------------- 备份与恢复 --------------------
BACKUP_COMMAND_TIMEOUT=30m
BACKUP_DOWNLOAD_TICKET_TTL=10m
BACKUP_RESTORE_MAX_ARCHIVE_BYTES=10737418240
BACKUP_RESTORE_MAX_EXTRACTED_BYTES=53687091200

# -------------------- 可选对象存储 --------------------
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_PREFIX=blog/
MEDIA_R2_READ_URL_TTL=15m
MEDIA_R2_REQUEST_TIMEOUT=4s
MEDIA_R2_UPLOAD_TIMEOUT=2m

# -------------------- 本地容器资源 --------------------
DEV_PROJECT_NAME=shawn-blog-dev
POSTGRES_VOLUME_NAME=shawn-blog_postgres_data
REDIS_VOLUME_NAME=shawn-blog_redis_data
GO_MOD_VOLUME_NAME=shawn-blog_go_mod
GO_BUILD_VOLUME_NAME=shawn-blog_go_build
DEV_NETWORK_NAME=shawn-blog-dev_default
DEV_NETWORK_EXTERNAL=false
